GRPC_PORT=:50051

# Azure SQL Database (DEV local: SQL Server 2022 en Docker)
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=db_users
SQL_USER=sa
SQL_PASSWORD=Local_Pass123!
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERT=true

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
CACHE_TTL=15m

# bcrypt
BCRYPT_COST=10

# JWT — generar con: openssl rand -base64 64
JWT_SECRET=replace-with-64-bytes-random-secret-from-key-vault
JWT_ISSUER=miproposito.users
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

SHUTDOWN_WAIT=10s
